<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "Bekræft sletning" som overlay (FK-08). Controlleren udfylder garnets oplysninger
     og vælger garnikon (yarnIcon) ud fra farven. -->
<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="440" styleClass="dialog"
      xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="awesomegarn.presentation.dialog.ConfirmDeleteDialogController">
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="dialog-header">
        <ImageView fitHeight="26" fitWidth="26" preserveRatio="true" smooth="true">
            <image>
                <Image url="@../images/warning.png"/>
            </image>
        </ImageView>
        <Label styleClass="dialog-title" text="Bekræft sletning"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#onCancel" styleClass="icon-button" text="✕"/>
    </HBox>
    <VBox alignment="CENTER" spacing="14">
        <padding>
            <Insets bottom="18" left="20" right="20" top="16"/>
        </padding>
        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-alignment: center;"
               text="Er du sikker på, at du vil slette dette garn?&#10;Handlingen kan ikke fortrydes." wrapText="true"/>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="error-list">
            <ImageView fx:id="yarnIcon" fitHeight="56" fitWidth="56" preserveRatio="true" smooth="true"/>
            <VBox spacing="4">
                <Label fx:id="colorLabel" text="Farve: "/>
                <Label fx:id="materialLabel" text="Materiale: "/>
                <Label fx:id="weightLabel" text="Vægt: "/>
                <Label fx:id="skeinsLabel" text="Antal nøgler: "/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER" spacing="14">
            <Button fx:id="cancelButton" cancelButton="true" onAction="#onCancel" styleClass="secondary-button"
                    text="Annullér"/>
            <Button fx:id="deleteButton" graphicTextGap="6" onAction="#onConfirm" styleClass="danger-button"
                    text="Slet garn">
                <graphic>
                    <ImageView fitHeight="18" fitWidth="18" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/delete.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
