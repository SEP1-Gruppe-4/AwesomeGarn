<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Hovedvinduets faste ramme: logo + faneknapper + indholdsområde. Views skiftes ind i contentHolder.
     overlayLayer ligger oven på alt og bruges til dialoger (fejl og sletning). -->
<StackPane styleClass="app-root" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="awesomegarn.presentation.main.MainController">
    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <VBox>
        <StackPane alignment="CENTER" styleClass="header">
            <ImageView fitWidth="200" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>
        </StackPane>

        <HBox spacing="8" styleClass="nav-bar">
            <Button fx:id="overviewTab" onAction="#onOverviewTab" styleClass="nav-button-active" text="Se oversigt"/>
            <Button fx:id="statisticsTab" onAction="#onStatisticsTab" styleClass="nav-button" text="Se statistik"/>
        </HBox>

        <StackPane fx:id="contentHolder" VBox.vgrow="ALWAYS"/>
    </VBox>

    <StackPane fx:id="overlayLayer" managed="false" styleClass="overlay-layer" visible="false"/>
</StackPane>
